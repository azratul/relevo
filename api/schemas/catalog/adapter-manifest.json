{
  "title": "Adapter manifest",
  "description": "Describes a host-side action adapter (docs/plugin-development.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "interfaceVersions",
    "protocolVersions",
    "platforms",
    "actions",
    "permissions",
    "confirmation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}(\\.[a-z][a-z0-9-]{1,40})*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "interfaceVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.json#/$defs/ProtocolVersion"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(/[a-z0-9-]+)?$",
        "description": "GOOS or GOOS/backend, e.g. linux/x11, linux/wayland-hyprland, windows, darwin."
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "parameters"
        ],
        "properties": {
          "id": {
            "$ref": "../common.json#/$defs/ActionId"
          },
          "capability": {
            "$ref": "../common.json#/$defs/Capability"
          },
          "parameters": {
            "$ref": "../common.json#/$defs/ParametersSchema"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "description": "Human-readable OS permissions the adapter needs (e.g. macOS Accessibility)."
    },
    "confirmation": {
      "$ref": "../common.json#/$defs/Confirmation"
    },
    "focusCheck": {
      "$ref": "../common.json#/$defs/FocusCheck"
    }
  }
}
