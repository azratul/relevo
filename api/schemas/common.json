{
  "title": "Relevo common definitions",
  "description": "Shared definitions. Dialect: common subset of JSON Schema draft-07 and 2020-12 (see docs/adr/0012).",
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,3}\\.[0-9]{1,4}$",
      "description": "MAJOR.MINOR of the application protocol (not the app version)."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "SessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "Public session identifier (128 random bits, base64url). Grants no permission."
    },
    "ParticipantId": {
      "type": "string",
      "pattern": "^p_[A-Za-z0-9_-]{16}$"
    },
    "ConnectionId": {
      "type": "string",
      "pattern": "^c_[A-Za-z0-9_-]{16}$"
    },
    "Token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Opaque bearer credential. Never put it in a URL."
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 wall-clock time. Informative only: never used for freshness decisions."
    },
    "DisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\u0000-\u001f\u007f]+$",
      "description": "Untrusted label chosen by the speaker. Not an identity."
    },
    "ActionId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]{0,30}(\\.[a-z][a-z0-9-]{0,30}){1,3}$"
    },
    "Capability": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]{0,30}(\\.[a-z][a-z0-9-]{0,30}){1,3}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "AUTH_FAILED",
        "AUTH_EXPIRED",
        "FORBIDDEN",
        "SESSION_CLOSED",
        "HOST_OFFLINE",
        "HOST_NOT_READY",
        "SESSION_PAUSED",
        "RATE_LIMITED",
        "INVALID_MESSAGE",
        "UNSUPPORTED_VERSION",
        "UNSUPPORTED_ACTION",
        "STALE_CATALOG",
        "TARGET_NOT_ACTIVE",
        "PERMISSION_DENIED",
        "COMMAND_EXPIRED",
        "COMMAND_ID_CONFLICT",
        "EXECUTION_UNKNOWN",
        "EXECUTION_FAILED",
        "NOT_FOUND",
        "INTERNAL_ERROR"
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 300,
          "description": "Human-readable, safe to display. Never contains secrets or internals."
        },
        "retryable": {
          "type": "boolean",
          "description": "True if the same request may succeed later without changes (a NEW commandId is still required for commands)."
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "ParticipantState": {
      "type": "string",
      "enum": [
        "pending",
        "enabled",
        "disabled",
        "revoked"
      ]
    },
    "Participant": {
      "type": "object",
      "required": [
        "participantId",
        "displayName",
        "state",
        "connected",
        "capabilities",
        "joinedAt"
      ],
      "properties": {
        "participantId": {
          "$ref": "#/$defs/ParticipantId"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayName"
        },
        "state": {
          "$ref": "#/$defs/ParticipantState"
        },
        "connected": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "joinedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "FocusCheck": {
      "type": "string",
      "enum": [
        "targeted",
        "verified",
        "unverified",
        "simulated"
      ],
      "description": "targeted: adapter addresses the target directly; verified: focus checked before each command; unverified: host explicitly allowed sending to the active window without checking; simulated: no real input."
    },
    "Target": {
      "type": "object",
      "required": [
        "label",
        "focusCheck"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "focusCheck": {
          "$ref": "#/$defs/FocusCheck"
        }
      }
    },
    "Confirmation": {
      "type": "string",
      "enum": [
        "simulated",
        "input-injected",
        "application-api",
        "effect-verified"
      ],
      "description": "What 'executed' means for this action: simulated (nothing happened), input-injected (OS accepted the input events, effect unknown), application-api (the application API accepted the call), effect-verified (the effect was observed)."
    },
    "ParametersSchema": {
      "type": "object",
      "maxProperties": 16,
      "description": "JSON Schema (common subset) for the action parameters. Must be an object schema; remote $ref is forbidden."
    },
    "ActionDescriptor": {
      "type": "object",
      "required": [
        "id",
        "title",
        "capability",
        "parameters",
        "confirmation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ActionId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "parameters": {
          "$ref": "#/$defs/ParametersSchema"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        }
      }
    },
    "Catalog": {
      "type": "object",
      "required": [
        "revision",
        "actions"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ActionDescriptor"
          }
        }
      }
    },
    "HostStatus": {
      "type": "object",
      "required": [
        "online",
        "ready"
      ],
      "properties": {
        "online": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "readinessReason": {
          "type": "string",
          "maxLength": 200
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "epoch": {
          "$ref": "#/$defs/Counter"
        }
      }
    },
    "SessionView": {
      "type": "object",
      "description": "Role-filtered view. Controllers get 'you' and never other participants; hosts get 'participants'.",
      "required": [
        "sessionId",
        "status",
        "paused",
        "requireApproval",
        "authzRevision",
        "host",
        "catalog",
        "expiresAt"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "requireApproval": {
          "type": "boolean"
        },
        "authzRevision": {
          "$ref": "#/$defs/Counter"
        },
        "host": {
          "$ref": "#/$defs/HostStatus"
        },
        "catalog": {
          "oneOf": [
            {
              "$ref": "#/$defs/Catalog"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "you": {
          "$ref": "#/$defs/Participant"
        },
        "participants": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Participant"
          }
        }
      }
    },
    "CommandStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "dispatched",
        "executed",
        "failed",
        "rejected",
        "expired",
        "unknown"
      ],
      "description": "Transient: accepted, dispatched. Terminal: executed, failed, rejected, expired, unknown."
    },
    "Limits": {
      "type": "object",
      "required": [
        "maxMessageBytes",
        "maxMessagesPerSecond",
        "commandValidForMs",
        "maxInFlightCommands"
      ],
      "properties": {
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxMessagesPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "commandValidForMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxInFlightCommands": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
