{
  "title": "host.registered",
  "description": "Relay -> host. The new epoch. Dispatches carrying another epoch MUST be rejected by the host.",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "messageId",
    "payload",
    "sessionId",
    "correlationId"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "../common.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "host.registered"
    },
    "messageId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "sessionId": {
      "$ref": "../common.json#/$defs/SessionId"
    },
    "correlationId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "epoch"
      ],
      "properties": {
        "epoch": {
          "$ref": "../common.json#/$defs/Revision"
        }
      }
    }
  }
}
