  "required": [
    "protocolVersion",
    "type",
    "messageId",
    "payload",
    "sessionId",
    "correlationId"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "../common.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "command.rejected"
    },
    "messageId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "sessionId": {
      "$ref": "../common.json#/$defs/SessionId"
    },
    "correlationId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "commandId",
        "error"
      ],
      "properties": {
        "commandId": {
          "$ref": "../common.json#/$defs/Uuid"
        },
        "error": {
          "$ref": "../common.json#/$defs/Error"
        }
      }
    }
  }
}
