{
  "title": "auth.hello",
  "description": "Client/host -> relay. MUST be the first message, within the auth timeout. Role and identity come from the token.",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "messageId",
    "payload",
    "sessionId"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "../common.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "auth.hello"
    },
    "messageId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "sessionId": {
      "$ref": "../common.json#/$defs/SessionId"
    },
    "correlationId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "$ref": "../common.json#/$defs/Token"
        },
        "client": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[^\u0000-\u001f\u007f]+$"
            },
            "version": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[^\u0000-\u001f\u007f]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
