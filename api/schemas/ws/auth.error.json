{
  "title": "auth.error",
  "description": "Relay -> client/host. Authentication failed; the relay closes the connection afterwards.",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "messageId",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "../common.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "auth.error"
    },
    "messageId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "sessionId": {
      "$ref": "../common.json#/$defs/SessionId"
    },
    "correlationId": {
      "$ref": "../common.json#/$defs/Uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "../common.json#/$defs/Error"
        }
      }
    }
  }
}
